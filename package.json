{
  "name": "dsh-voice-live",
  "description": "Real-time duplex voice for DeepSeek Harness: Volcengine streaming ASR/TTS, agent reply narration, barge-in, wake word, live captions. | 实时双工语音插件：火山流式 ASR/TTS、回复朗读、打断、唤醒词、实时字幕。",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tangzheng202202/dsh-voice-live.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.21.0",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.5",
    "@deepseek-ai/dsh-session": "0.0.1-rc.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.18",
    "@types/react-dom": "~18.3.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "3.2.4"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "voice",
    "asr",
    "tts",
    "volcengine",
    "plugin"
  ],
  "homepage": "https://github.com/tangzheng202202/dsh-voice-live#readme",
  "bugs": {
    "url": "https://github.com/tangzheng202202/dsh-voice-live/issues"
  }
}
